        "//third-party:async-trait",
    ],
    visibility = ["PUBLIC"],
)

# ── Test targets ─────────────────────────────────────────────────────────────

# Support module shared across integration test binaries.
_TEST_SUPPORT = [
    "tests/support/mod.rs",
    "tests/support/corpus.rs",
    "tests/support/fake_daemon.rs",
]

# Dev-dependencies used by test targets (not the library).
_TEST_DEPS = [
    ":pantoken_server_lib",
    "//server/pantoken-daemon-types:pantoken_daemon_types",
    "//server/pantoken-protocol:pantoken_protocol",
    "//third-party:serde_json",
    "//third-party:tempfile",
    "//third-party:tokio",
    "//third-party:tracing",
]

# Corpus tests — canonicalization + canon-parity golden comparison.
rust_test(
    name = "corpus_tests",
    srcs = ["tests/corpus.rs"] + _TEST_SUPPORT,
    crate_root = "tests/corpus.rs",
    deps = _TEST_DEPS,
    env = {"CARGO_MANIFEST_DIR": "server/pantoken-server"},
    resources = [
        "//server/tests:corpus_json",
        "//server/tests:canon_parity_json",
    ],
    run_env = {
        # $(location <filegroup>) expands to the filegroup's output DIRECTORY
        # (containing srcs at their package-relative paths), so point the
        # *_DIR vars at the subtree root the tests expect.
        "PANTOKEN_CORPUS_DIR": "$(location //server/tests:corpus_json)/corpus",
        "PANTOKEN_CANON_PARITY_DIR": "$(location //server/tests:canon_parity_json)/canon-parity",
        "HOME": ".",
    },
    visibility = ["PUBLIC"],
)

# Live-path tests — fake-daemon integration against the frozen corpus.
rust_test(
    name = "live_path_tests",
    srcs = ["tests/live_path.rs"] + _TEST_SUPPORT,
    crate_root = "tests/live_path.rs",
    deps = _TEST_DEPS,
    env = {"CARGO_MANIFEST_DIR": "server/pantoken-server"},
    resources = ["//server/tests:corpus_json"],
    run_env = {
        "PANTOKEN_CORPUS_DIR": "$(location //server/tests:corpus_json)/corpus",
        "HOME": ".",
    },
    visibility = ["PUBLIC"],
)

# Deterministic gap-scenario contract tests (issue #135) — strict-fake
