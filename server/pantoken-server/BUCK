# Buck2 BUCK file for pantoken-server.
# Cargo remains authoritative; this is additive for the Buck2 POC.
# Rust rules are built-in Buck2 globals — no load needed.
#
# The build.rs sets cargo:rustc-env=PANTOKEN_BUILD_SHA based on the
# PANTOKEN_BUILD_SHA env var. Under Buck2, we set this env var directly
# on the library/binary targets using the `env` attribute (which sets
# rustc environment variables), equivalent to cargo:rustc-env.
#
# Note: Buck2 rust_test has no `data` attribute; test data files are declared
# via `resources` and referenced in `run_env` via $(location). Runtime
# binaries (PANTOKEN_SERVER_BIN) are also declared as resources.

rust_library(
    name = "pantoken_server_lib",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate = "pantoken_server",
    edition = "2024",
    # PANTOKEN_BUILD_SHA is set via build.rs in Cargo. Under Buck2, we set it
    # directly as a rustc env var. Values come from the [pantoken] config
    # section (.buckconfig.ci in CI; see root BUCK's version_file/build_sha_file
    # for the same mechanism), so release builds embed the real SHA.
    env = {
        "PANTOKEN_BUILD_SHA": read_config("pantoken", "build_sha", "dev-buck2"),
        "PANTOKEN_RELEASE_BUILD": "1" if read_config("pantoken", "release_build", "0") == "1" else "0",
        # CARGO_MANIFEST_DIR is used by env!() in config.rs and corpus.rs to
        # locate client/dist and tests/corpus. Cargo sets this automatically;
        # Buck2 doesn't, so we set it to the crate's source directory.
        "CARGO_MANIFEST_DIR": "server/pantoken-server",
    },
    deps = [
        "//server/pantoken-daemon-types:pantoken_daemon_types",
        "//server/pantoken-protocol:pantoken_protocol",
        "//server/pantoken-remote-layout:pantoken_remote_layout",
        "//third-party:axum",
        "//third-party:chrono",
        "//third-party:ct-codecs",
        "//third-party:flate2",
        "//third-party:futures-util",
        "//third-party:http",
        "//third-party:ignore",
        "//third-party:jwt-simple",
        "//third-party:libc",
        "//third-party:notify",
        "//third-party:parking_lot",
        "//third-party:rand",
        "//third-party:reqwest",
        "//third-party:serde",
        "//third-party:serde_json",
        "//third-party:tokio",
        "//third-party:tokio-stream",
        "//third-party:tower",
        "//third-party:tower-http",
        "//third-party:tracing",
        "//third-party:tracing-subscriber",
        "//third-party:urlencoding",
        "//third-party:web-push",
        "//third-party:ece",
        # async-trait is a proc-macro crate — in Buck2, proc macros are regular deps
        "//third-party:async-trait",
    ],
    visibility = ["PUBLIC"],
)

# Inline unit tests for the library crate. The crate= attribute enables
# cfg(test) on pantoken_server_lib and adds only the crate's Cargo
# dev-dependencies used by inline modules.
rust_test(
    name = "server_lib_unit_tests",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate = "pantoken_server",
    edition = "2024",
    env = {
        "PANTOKEN_BUILD_SHA": read_config("pantoken", "build_sha", "dev-buck2"),
        "PANTOKEN_RELEASE_BUILD": "1" if read_config("pantoken", "release_build", "0") == "1" else "0",
        "CARGO_MANIFEST_DIR": "server/pantoken-server",
    },
    run_env = {
        "HOME": ".",
    },
    deps = [
        "//server/pantoken-daemon-types:pantoken_daemon_types",
        "//server/pantoken-protocol:pantoken_protocol",
        "//server/pantoken-remote-layout:pantoken_remote_layout",
        "//third-party:axum",
        "//third-party:chrono",
        "//third-party:ct-codecs",
        "//third-party:flate2",
        "//third-party:futures-util",
        "//third-party:ignore",
        "//third-party:jwt-simple",
        "//third-party:libc",
        "//third-party:notify",
        "//third-party:parking_lot",
        "//third-party:rand",
        "//third-party:reqwest",
        "//third-party:serde",
        "//third-party:serde_json",
        "//third-party:tokio",
        "//third-party:tokio-stream",
        "//third-party:tower",
        "//third-party:tower-http",
        "//third-party:tracing",
        "//third-party:tracing-subscriber",
        "//third-party:urlencoding",
        "//third-party:web-push",
        "//third-party:ece",
        "//third-party:async-trait",
        # Dev-dependencies used by cfg(test) modules
        "//third-party:http",
        "//third-party:filetime",
        "//third-party:tempfile",
    ],
    visibility = ["PUBLIC"],
)

