# Buck2 toolchain configuration for the pantoken project.
#
# Uses the prelude's demo toolchains which register system-provided
# toolchains for Rust, CXX, genrule, and test execution.
# The `buck2-check` preflight script verifies the exact rustc version,
# host/target triple, and edition before any Buck2 graph command.
#
# Supported platforms: aarch64-apple-darwin, x86_64-unknown-linux-gnu,
# aarch64-unknown-linux-gnu.

load("@prelude//toolchains:cxx.bzl", "system_cxx_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:python.bzl", "system_python_bootstrap_toolchain")
load("@prelude//toolchains:rust.bzl", "system_rust_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")
load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load("@prelude//toolchains:zip_file.bzl", "zip_file_toolchain")

# Register only the toolchains this project uses (instead of the demo kitchen sink).
# The Rust toolchain denies warnings to match `cargo clippy -- -D warnings`;
# `deny_lints` applies to all Rust compilations (build, test, clippy, check subtargets).
system_cxx_toolchain(
    name = "cxx",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    visibility = ["PUBLIC"],
)

system_rust_toolchain(
    name = "rust",
    default_edition = "2021",
    deny_lints = ["warnings"],
    visibility = ["PUBLIC"],
)

remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)

noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

zip_file_toolchain(
    name = "zip_file",
    visibility = ["PUBLIC"],
)
