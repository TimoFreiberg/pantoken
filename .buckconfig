# Buck2 configuration for the pantoken Buck2 POC.
# Cargo/pnpm remain authoritative. Buck2 is additive and experimental.
# See docs/buck2-poc-findings.md for the full POC boundary and policy.

[cells]
  root = .
  prelude = prelude
  toolchains = toolchains
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

# Uses a copy of the prelude bundled with the buck2 binary.
[external_cells]
  prelude = bundled

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default

[build]
  execution_platforms = prelude//platforms:default

[buck2]
  # Materialize outputs to buck-out for easy inspection.
  materialized = true

[project]
  # Exclude jj workspaces and build artifacts from Buck2's recursive BUCK scan.
  ignore = .workspaces, buck-out, target, node_modules
