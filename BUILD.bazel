load("@rules_pkg//:mappings.bzl", "pkg_files", "pkg_attributes")
load("@rules_pkg//:pkg.bzl", "pkg_tar")

# Root BUILD file — needed so //:Cargo.lock and //:Cargo.toml resolve as labels
# for crate_universe's crate.from_cargo. Archive assembly targets are also here.

# ── Pre-built client-dist (pnpm stays authoritative) ─────────────────────────
# Requires `just build-client` to have been run first. Bazel consumes the output
# as a file input; it does not invoke pnpm/Vite.

# Mirrors the allowlist in scripts/headless/build.ts:copyDirRecursive —
# only index.html, assets/, and PWA root files (icons, manifest, sw) are allowed.
filegroup(
    name = "client_dist",
    srcs = glob(
        [
            "client/dist/index.html",
            "client/dist/assets/**",
            "client/dist/apple-touch-icon*",
            "client/dist/icon*",
            "client/dist/favicon*",
            "client/dist/manifest*",
            "client/dist/sw*",
            "client/dist/registerSW*",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# ── VERSION + BUILD_SHA files ────────────────────────────────────────────────

genrule(
    name = "version_file",
    outs = ["VERSION"],
    cmd = "echo '0.0.0-dev' > $@",
)

genrule(
    name = "build_sha_file",
    outs = ["BUILD_SHA"],
    cmd = "echo '0000000000000000000000000000000000000000' > $@",
)

# ── Binaries (with mode 0755, prefixed under bin/) ───────────────────────────

pkg_files(
    name = "binaries",
    srcs = [
        "//server-rs/pantoken-server:pantoken_server",
        "//server-rs/pantoken-tar-validate:pantoken_tar_validate",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "bin",
    renames = {
        "//server-rs/pantoken-server:pantoken_server": "pantoken-server",
        "//server-rs/pantoken-tar-validate:pantoken_tar_validate": "pantoken-tar-validate",
    },
)

# ── Deploy scripts (with mode 0755, update-headless.sh → update.sh) ──────────

pkg_files(
    name = "scripts",
    srcs = [
        "deploy/run.sh",
        "deploy/update-headless.sh",
    ],
    attributes = pkg_attributes(mode = "0755"),
    renames = {
        "deploy/run.sh": "run.sh",
        "deploy/update-headless.sh": "update.sh",
    },
)

# ── Client-dist files (prefixed under client-dist/) ─────────────────────────

pkg_files(
    name = "client_dist_files",
    srcs = [":client_dist"],
    prefix = "client-dist",
    strip_prefix = "client/dist",
)

# ── VERSION + BUILD_SHA files ────────────────────────────────────────────────

pkg_files(
    name = "metadata_files",
    srcs = [
        ":version_file",
        ":build_sha_file",
    ],
)

# ── Unsigned headless archive ───────────────────────────────────────────────
# Layout matches the real release artifact: flat root (no package_dir).
#   VERSION, BUILD_SHA, bin/pantoken-server, bin/pantoken-tar-validate,
#   run.sh, update.sh, client-dist/index.html, client-dist/assets/*

pkg_tar(
    name = "pantoken_headless_unsigned",
    srcs = [
        ":binaries",
        ":scripts",
        ":client_dist_files",
        ":metadata_files",
    ],
    extension = "tar.gz",
)

# ── Validation sh_test ───────────────────────────────────────────────────────

sh_test(
    name = "validate_headless_archive",
    srcs = ["scripts/bazel/validate-archive.sh"],
    args = [
        "$(location //server-rs/pantoken-tar-validate:pantoken_tar_validate)",
        "$(location :pantoken_headless_unsigned)",
    ],
    data = [
        ":pantoken_headless_unsigned",
        "//server-rs/pantoken-tar-validate:pantoken_tar_validate",
    ],
)
