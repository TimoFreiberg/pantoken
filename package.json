{
  "name": "pantoken",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:client": "pnpm --filter @pantoken/client dev",
    "build": "pnpm --filter @pantoken/client build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "check": "tsc -p protocol/tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.e2e.json --noEmit && tsc -p tsconfig.parity.json --noEmit && pnpm --filter @pantoken/client check"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.1.1",
    "fake-indexeddb": "^6.0.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "protocol",
    "client",
    "desktop"
  ]
}
