load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# ── Build script ───────────────────────────────────────────────────────────
# build.rs sets cargo:rustc-env=PANTOKEN_BUILD_SHA based on the PANTOKEN_BUILD_SHA
# env var. Under Bazel, cargo_build_script handles this; the env values flow to
# the library/binary that depend on :build_script.

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    build_script_env = {
        "PANTOKEN_BUILD_SHA": "dev-bazel",
        "PANTOKEN_RELEASE_BUILD": "0",
    },
    edition = "2024",
    visibility = ["//visibility:private"],
)

# ── Library ─────────────────────────────────────────────────────────────────
# crate_name matches the Cargo package name so `use pantoken_server::...` resolves.

rust_library(
    name = "pantoken_server_lib",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "pantoken_server",
    edition = "2024",
    deps = [
        ":build_script",
        "//server-rs/pantoken-daemon-types:pantoken_daemon_types",
        "//server-rs/pantoken-protocol:pantoken_protocol",
        "//server-rs/pantoken-remote-layout:pantoken_remote_layout",
        "@crates//axum",
        "@crates//chrono",
        "@crates//ct-codecs",
        "@crates//flate2",
        "@crates//futures-util",
        "@crates//ignore",
        "@crates//jwt-simple",
        "@crates//libc",
        "@crates//notify",
        "@crates//parking_lot",
        "@crates//rand",
        "@crates//reqwest",
        "@crates//serde",
        "@crates//serde_json",
        "@crates//tokio",
        "@crates//tokio-stream",
        "@crates//tower",
        "@crates//tower-http",
        "@crates//tracing",
        "@crates//tracing-subscriber",
        "@crates//urlencoding",
        "@crates//web-push",
    ],
    proc_macro_deps = [
        "@crates//async-trait",
    ],
    visibility = ["//visibility:public"],
)

# ── Binary ──────────────────────────────────────────────────────────────────

rust_binary(
    name = "pantoken_server",
    srcs = ["src/main.rs"],
    edition = "2024",
    deps = [
        ":pantoken_server_lib",
        "//server-rs/pantoken-daemon-types:pantoken_daemon_types",
        "//server-rs/pantoken-protocol:pantoken_protocol",
        "@crates//axum",
        "@crates//parking_lot",
        "@crates//serde",
        "@crates//serde_json",
        "@crates//tokio",
        "@crates//tower",
        "@crates//tower-http",
        "@crates//tracing",
        "@crates//tracing-subscriber",
    ],
    proc_macro_deps = [
        "@crates//async-trait",
    ],
    visibility = ["//visibility:public"],
)

# ── Test targets ────────────────────────────────────────────────────────────
# Support module shared across integration test binaries.

_TEST_SUPPORT = [
    "tests/support/mod.rs",
    "tests/support/corpus.rs",
    "tests/support/fake_daemon.rs",
]

# Dev-dependencies used by test targets (not the library).
_TEST_DEPS = [
    ":pantoken_server_lib",
    "//server-rs/pantoken-daemon-types:pantoken_daemon_types",
    "//server-rs/pantoken-protocol:pantoken_protocol",
    "@crates//serde_json",
    "@crates//tempfile",
    "@crates//tokio",
    "@crates//tracing",
]

# Corpus tests — canonicalization + canon-parity golden comparison.
rust_test(
    name = "corpus_tests",
    srcs = [
        "tests/corpus.rs",
    ] + _TEST_SUPPORT,
    crate_root = "tests/corpus.rs",
    deps = _TEST_DEPS,
    data = [
        "//server-rs/tests:corpus_json",
        "//server-rs/tests:canon_parity_json",
    ],
    env = {
        "PANTOKEN_CORPUS_FILES": "$(rootpaths //server-rs/tests:corpus_json)",
        "PANTOKEN_CANON_PARITY_FILES": "$(rootpaths //server-rs/tests:canon_parity_json)",
    },
    env_inherit = ["HOME"],
)

# Live-path tests — fake-daemon integration against the frozen corpus.
rust_test(
    name = "live_path_tests",
    srcs = [
        "tests/live_path.rs",
    ] + _TEST_SUPPORT,
    crate_root = "tests/live_path.rs",
    deps = _TEST_DEPS,
    data = [
        "//server-rs/tests:corpus_json",
    ],
    env = {
        "PANTOKEN_CORPUS_FILES": "$(rootpaths //server-rs/tests:corpus_json)",
    },
    env_inherit = ["HOME"],
)

# WebSocket adapter contract tests.
rust_test(
    name = "websocket_adapter_tests",
    srcs = [
        "tests/websocket_adapter_contract_tests.rs",
    ] + _TEST_SUPPORT,
    crate_root = "tests/websocket_adapter_contract_tests.rs",
    deps = _TEST_DEPS + [
        "@crates//axum",
        "@crates//futures-util",
        "@crates//tokio-tungstenite",
    ],
    env_inherit = ["HOME"],
)

# Stdio adapter contract tests.
rust_test(
    name = "stdio_adapter_tests",
    srcs = [
        "tests/stdio_adapter_contract_tests.rs",
    ] + _TEST_SUPPORT,
    crate_root = "tests/stdio_adapter_contract_tests.rs",
    deps = _TEST_DEPS,
    env_inherit = ["HOME"],
)

# Resume and recovery tests.
rust_test(
    name = "resume_and_recovery_tests",
    srcs = [
        "tests/resume_and_recovery_tests.rs",
    ] + _TEST_SUPPORT,
    crate_root = "tests/resume_and_recovery_tests.rs",
    deps = _TEST_DEPS,
    env_inherit = ["HOME"],
)

# Remote runtime integration tests.
rust_test(
    name = "remote_runtime_tests",
    srcs = [
        "tests/remote_runtime_integration_tests.rs",
    ] + _TEST_SUPPORT,
    crate_root = "tests/remote_runtime_integration_tests.rs",
    deps = _TEST_DEPS,
    env_inherit = ["HOME"],
)
