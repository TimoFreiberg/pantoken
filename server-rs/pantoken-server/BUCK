# Buck2 BUCK file for pantoken-server.
# Cargo remains authoritative; this is additive for the Buck2 POC.
# Mirrors server-rs/pantoken-server/BUILD.bazel.
# Rust rules are built-in Buck2 globals — no load needed.
#
# The build.rs sets cargo:rustc-env=PANTOKEN_BUILD_SHA based on the
# PANTOKEN_BUILD_SHA env var. Under Buck2, we set this env var directly
# on the library/binary targets using the `env` attribute (which sets
# rustc environment variables), equivalent to cargo:rustc-env.
#
# Note: Buck2 rust_test has no `data` attribute; test data files are declared
# via `resources` and referenced in `run_env` via $(location). Runtime
# binaries (PANTOKEN_SERVER_BIN) are also declared as resources.

rust_library(
    name = "pantoken_server_lib",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate = "pantoken_server",
    edition = "2024",
    # PANTOKEN_BUILD_SHA is set via build.rs in Cargo. Under Buck2, we set it
    # directly as a rustc env var. This mirrors the Bazel cargo_build_script env.
    env = {
        "PANTOKEN_BUILD_SHA": "dev-buck2",
        "PANTOKEN_RELEASE_BUILD": "0",
    },
    deps = [
        "//server-rs/pantoken-daemon-types:pantoken_daemon_types",
        "//server-rs/pantoken-protocol:pantoken_protocol",
        "//server-rs/pantoken-remote-layout:pantoken_remote_layout",
        "//third-party:axum",
        "//third-party:chrono",
        "//third-party:ct-codecs",
        "//third-party:flate2",
        "//third-party:futures-util",
        "//third-party:ignore",
        "//third-party:jwt-simple",
        "//third-party:libc",
        "//third-party:notify",
        "//third-party:parking_lot",
        "//third-party:rand",
        "//third-party:reqwest",
        "//third-party:serde",
        "//third-party:serde_json",
        "//third-party:tokio",
        "//third-party:tokio-stream",
        "//third-party:tower",
        "//third-party:tower-http",
        "//third-party:tracing",
        "//third-party:tracing-subscriber",
        "//third-party:urlencoding",
        "//third-party:web-push",
        # async-trait is a proc-macro crate — in Buck2, proc macros are regular deps
        "//third-party:async-trait",
    ],
    visibility = ["PUBLIC"],
)

# Inline unit tests for the library crate. The crate= attribute enables
# cfg(test) on pantoken_server_lib and adds only the crate's Cargo
# dev-dependencies used by inline modules.
rust_test(
    name = "server_lib_unit_tests",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate = "pantoken_server",
    edition = "2024",
    env = {
        "PANTOKEN_BUILD_SHA": "dev-buck2",
        "PANTOKEN_RELEASE_BUILD": "0",
    },
    run_env = {
        "HOME": ".",
    },
    deps = [
        "//server-rs/pantoken-daemon-types:pantoken_daemon_types",
        "//server-rs/pantoken-protocol:pantoken_protocol",
        "//server-rs/pantoken-remote-layout:pantoken_remote_layout",
        "//third-party:axum",
        "//third-party:chrono",
        "//third-party:ct-codecs",
        "//third-party:flate2",
        "//third-party:futures-util",
        "//third-party:ignore",
        "//third-party:jwt-simple",
        "//third-party:libc",
        "//third-party:notify",
        "//third-party:parking_lot",
        "//third-party:rand",
        "//third-party:reqwest",
        "//third-party:serde",
        "//third-party:serde_json",
        "//third-party:tokio",
        "//third-party:tokio-stream",
        "//third-party:tower",
        "//third-party:tower-http",
        "//third-party:tracing",
        "//third-party:tracing-subscriber",
        "//third-party:urlencoding",
        "//third-party:web-push",
        "//third-party:async-trait",
        # Dev-dependencies used by cfg(test) modules
        "//third-party:http",
        "//third-party:filetime",
        "//third-party:tempfile",
    ],
    visibility = ["PUBLIC"],
)

# ── Binary ───────────────────────────────────────────────────────────────────

rust_binary(
    name = "pantoken_server",
    srcs = ["src/main.rs"],
    edition = "2024",
    env = {
        "PANTOKEN_BUILD_SHA": "dev-buck2",
        "PANTOKEN_RELEASE_BUILD": "0",
    },
    deps = [
        ":pantoken_server_lib",
        "//server-rs/pantoken-daemon-types:pantoken_daemon_types",
        "//server-rs/pantoken-protocol:pantoken_protocol",
        "//third-party:axum",
        "//third-party:parking_lot",
        "//third-party:serde",
        "//third-party:serde_json",
        "//third-party:tokio",
        "//third-party:tower",
        "//third-party:tower-http",
        "//third-party:tracing",
        "//third-party:tracing-subscriber",
        # async-trait is a proc-macro crate — in Buck2, proc macros are regular deps
        "//third-party:async-trait",
    ],
    visibility = ["PUBLIC"],
)

# ── Test targets ─────────────────────────────────────────────────────────────

# Support module shared across integration test binaries.
_TEST_SUPPORT = [
    "tests/support/mod.rs",
    "tests/support/corpus.rs",
    "tests/support/fake_daemon.rs",
]

# Dev-dependencies used by test targets (not the library).
_TEST_DEPS = [
    ":pantoken_server_lib",
    "//server-rs/pantoken-daemon-types:pantoken_daemon_types",
    "//server-rs/pantoken-protocol:pantoken_protocol",
    "//third-party:serde_json",
    "//third-party:tempfile",
    "//third-party:tokio",
    "//third-party:tracing",
]

# Corpus tests — canonicalization + canon-parity golden comparison.
rust_test(
    name = "corpus_tests",
    srcs = ["tests/corpus.rs"] + _TEST_SUPPORT,
    crate_root = "tests/corpus.rs",
    deps = _TEST_DEPS,
    resources = [
        "//server-rs/tests:corpus_json",
        "//server-rs/tests:canon_parity_json",
    ],
    run_env = {
        "PANTOKEN_CORPUS_FILES": "$(location //server-rs/tests:corpus_json)",
        "PANTOKEN_CANON_PARITY_FILES": "$(location //server-rs/tests:canon_parity_json)",
        "HOME": ".",
    },
    visibility = ["PUBLIC"],
)

# Live-path tests — fake-daemon integration against the frozen corpus.
rust_test(
    name = "live_path_tests",
    srcs = ["tests/live_path.rs"] + _TEST_SUPPORT,
    crate_root = "tests/live_path.rs",
    deps = _TEST_DEPS,
    resources = ["//server-rs/tests:corpus_json"],
    run_env = {
        "PANTOKEN_CORPUS_FILES": "$(location //server-rs/tests:corpus_json)",
        "HOME": ".",
    },
    visibility = ["PUBLIC"],
)

# WebSocket adapter contract tests.
rust_test(
    name = "websocket_adapter_tests",
    srcs = ["tests/websocket_adapter_contract_tests.rs"] + _TEST_SUPPORT,
    crate_root = "tests/websocket_adapter_contract_tests.rs",
    deps = _TEST_DEPS + [
        "//third-party:axum",
        "//third-party:futures-util",
        "//third-party:tokio-tungstenite",
    ],
    run_env = {"HOME": "."},
    visibility = ["PUBLIC"],
)

# Stdio adapter contract tests.
rust_test(
    name = "stdio_adapter_tests",
    srcs = ["tests/stdio_adapter_contract_tests.rs"] + _TEST_SUPPORT,
    crate_root = "tests/stdio_adapter_contract_tests.rs",
    deps = _TEST_DEPS,
    run_env = {"HOME": "."},
    visibility = ["PUBLIC"],
)

# Resume and recovery tests — requires the server binary at runtime.
rust_test(
    name = "resume_and_recovery_tests",
    srcs = ["tests/resume_and_recovery_tests.rs"] + _TEST_SUPPORT,
    crate_root = "tests/resume_and_recovery_tests.rs",
    deps = _TEST_DEPS,
    resources = [":pantoken_server"],
    run_env = {
        "HOME": ".",
        "PANTOKEN_SERVER_BIN": "$(location :pantoken_server)",
    },
    visibility = ["PUBLIC"],
)

# Remote runtime integration tests — requires the server binary at runtime.
rust_test(
    name = "remote_runtime_tests",
    srcs = ["tests/remote_runtime_integration_tests.rs"] + _TEST_SUPPORT,
    crate_root = "tests/remote_runtime_integration_tests.rs",
    deps = _TEST_DEPS,
