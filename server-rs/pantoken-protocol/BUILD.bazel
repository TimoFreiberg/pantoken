load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "pantoken_protocol",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "@crates//serde",
        "@crates//serde_json",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "fold_corpus_tests",
    srcs = ["tests/fold_corpus.rs"],
    data = [":fold_corpus_data"],
    deps = [
        ":pantoken_protocol",
        "@crates//serde_json",
    ],
    env = {"PANTOKEN_FOLD_CORPUS_FILES": "$(rootpaths :fold_corpus_data)"},
)

# Expose the fold-corpus directory as a filegroup so $(rootpath) can reference it.
filegroup(
    name = "fold_corpus_data",
    srcs = glob(["tests/fold-corpus/**/*.json"]),
    visibility = ["//visibility:public"],
)
