# Buck2 BUCK file for pantoken-tar-validate.
# Cargo remains authoritative; this is additive for the Buck2 POC.
# Rust rules are built-in Buck2 globals — no load needed.

rust_library(
    name = "pantoken_tar_validate_lib",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate = "pantoken_tar_validate",
    edition = "2024",
    deps = [
        "//third-party:flate2",
        "//third-party:tar",
    ],
    visibility = ["PUBLIC"],
)

rust_binary(
    name = "pantoken_tar_validate",
    srcs = ["src/main.rs"],
    edition = "2024",
    deps = [":pantoken_tar_validate_lib"],
    visibility = ["PUBLIC"],
)

# Inline unit tests for the library crate.
# Only include lib.rs and lib's submodules (not main.rs which is the binary).
rust_test(
    name = "unit_tests",
    srcs = glob(["src/lib.rs", "src/**/*.rs"], exclude = ["src/main.rs"]),
    crate_root = "src/lib.rs",
    crate = "pantoken_tar_validate",
    edition = "2024",
    deps = [
        "//third-party:flate2",
        "//third-party:tar",
    ],
    visibility = ["PUBLIC"],
)
