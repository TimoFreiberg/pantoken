load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "pantoken_daemon_types",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "//server-rs/pantoken-protocol:pantoken_protocol",
        "@crates//serde",
        "@crates//serde_json",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "target_version_test",
    srcs = ["tests/target_version_test.rs"],
    deps = [":pantoken_daemon_types"],
)

rust_test(
    name = "daemon_types_roundtrip",
    srcs = ["tests/daemon_types_roundtrip.rs"],
    deps = [
        ":pantoken_daemon_types",
        "@crates//serde_json",
    ],
)
