# Exposes corpus test data as filegroups for cross-package reference from
# pantoken-server's test targets. The corpus lives here (server-rs/tests/)
# because it's shared across crates, not inside pantoken-server/.

filegroup(
    name = "corpus_json",
    srcs = glob(["corpus/**/*.json"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "canon_parity_json",
    srcs = glob(["canon-parity/**/*.json"]),
    visibility = ["//visibility:public"],
)
