# Local Buck2 config for remote cache.
# Copy to .buckconfig.remote-cache and fill in the real Tailscale address.
# .buckconfig.remote-cache is gitignored.
#
# Usage:
#   buck2 build --config-file .buckconfig.remote-cache //...
#   just buck2-build-cached
#
# Requires bazel-remote running on the cache host (see deploy/DEPLOY.md).

[buck2_re_client]
engine_address = <tailnet-host>:9092
action_cache_address = <tailnet-host>:9092
cas_address = <tailnet-host>:9092
tls = false
instance_name = buck2

[build]
execution_platforms = toolchains//platforms:remote_cache
