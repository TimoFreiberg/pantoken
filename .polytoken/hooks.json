[
  {
    "name": "check-integration-before-stop",
    "event": "stop",
    "handler": {
      "bash": "exec .polytoken/hooks/stop-check-integration.sh"
    }
  },
  {
    "name": "stamp-session-id-on-pushd",
    "event": "post_tool_use",
    "matcher": "pushd",
    "handler": {
      "bash": "exec .polytoken/hooks/stamp-session-id.sh"
    }
  },
  {
    "name": "check-workspace-in-plan-before-handoff",
    "event": "pre_tool_use",
    "matcher": "handoff_plan",
    "handler": {
      "bash": "exec .polytoken/hooks/pre-handoff-check-workspace.sh"
    }
  }
]
